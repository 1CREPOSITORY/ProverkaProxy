////////////////////////////////////////////////////////////////////////////////
// ДИАГНОСТИКА СИСТЕМНОГО ПРОКСИ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ПолучитьНастройкиСистемногоПрокси()

	Попытка

		Прокси = Новый ИнтернетПрокси(Истина);

		HTTPСервер = Прокси.Сервер("http");
		HTTPПорт = Прокси.Порт("http");

		HTTPSСервер = Прокси.Сервер("https");
		HTTPSПорт = Прокси.Порт("https");

		Возврат
			"HTTP: " + HTTPСервер + ":" + Строка(HTTPПорт)
			+ Символы.ПС
			+ "HTTPS: " + HTTPSСервер + ":" + Строка(HTTPSПорт);

	Исключение

		Возврат
			"Ошибка:"
			+ Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

	КонецПопытки;

КонецФункции


&НаКлиенте
Процедура ПоказатьНастройкиСистемногоПрокси(Команда)

	Сообщить(ПолучитьНастройкиСистемногоПрокси());

КонецПроцедуры                       

////////////////////////////////////////////////////////////////////////////////
// ПРОВЕРКА ЧЕРЕЗ БСП
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ПроверитьПроксиБСПНаСервере()

	Попытка

		МодульПолучениеФайловИзИнтернета =
			ОбщегоНазначения.ОбщийМодуль("ПолучениеФайловИзИнтернета");

		Прокси =
			МодульПолучениеФайловИзИнтернета.ПолучитьПрокси("https");

		HTTPСервер = Прокси.Сервер("http");
		HTTPПорт = Прокси.Порт("http");

		HTTPSСервер = Прокси.Сервер("https");
		HTTPSПорт = Прокси.Порт("https");

		ОписаниеПрокси =
			"Прокси БСП:"
			+ Символы.ПС
			+ "HTTP: " + HTTPСервер + ":" + Строка(HTTPПорт)
			+ Символы.ПС
			+ "HTTPS: " + HTTPSСервер + ":" + Строка(HTTPSПорт)
			+ Символы.ПС
			+ Символы.ПС;

		РезультатПроверки = ВыполнитьПроверкуIP(Прокси);

		Возврат ОписаниеПрокси + РезультатПроверки;

	Исключение

		Возврат
			"Ошибка проверки через БСП:"
			+ Символы.ПС
			+ ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке());

	КонецПопытки;

КонецФункции


&НаКлиенте
Процедура ПроверкаЧерезБСП(Команда)

	Сообщить(ПроверитьПроксиБСПНаСервере());

КонецПроцедуры