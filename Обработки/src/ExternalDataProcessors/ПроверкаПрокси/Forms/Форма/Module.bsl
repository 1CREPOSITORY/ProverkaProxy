////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ СЕРВЕРНЫЙ ТЕСТ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ВыполнитьПроверкуIP(Прокси = Неопределено)

	Попытка

		Соединение = Новый HTTPСоединение(
			"api.ipify.org",
			443,
			,
			,
			Прокси,
			10,
			Новый ЗащищенноеСоединениеOpenSSL()
		);

		Запрос = Новый HTTPЗапрос("/");
		Ответ = Соединение.Получить(Запрос);

		Если Ответ.КодСостояния <> 200 Тогда
			Возврат
				"HTTP: " + Строка(Ответ.КодСостояния)
				+ Символы.ПС
				+ Ответ.ПолучитьТелоКакСтроку();
		КонецЕсли;

		Возврат
			"HTTP: 200"
			+ Символы.ПС
			+ "IP: " + СокрЛП(Ответ.ПолучитьТелоКакСтроку());

	Исключение

		Возврат
			"Ошибка:"
			+ Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

	КонецПопытки;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ЯВНО ЗАДАННЫЙ ПРОКСИ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ПроверитьЯвныйПроксиНаСервере()

	Прокси = Новый ИнтернетПрокси;

	Прокси.Установить(
		"https",
		"1c-proxy.test.phoenixtrading.ltd",
		4129,
		"svc_1c_proxy",
		"8xC|t9Ag26YHXF%umNw4tVu9F"
	);

	Возврат ВыполнитьПроверкуIP(Прокси);

КонецФункции


&НаКлиенте
Процедура ПроверкаЯвно(Команда)

	Сообщить(ПроверитьЯвныйПроксиНаСервере());

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СИСТЕМНЫЙ ПРОКСИ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ПроверитьСистемныйПроксиНаСервере()

	Прокси = Новый ИнтернетПрокси(Истина);

	Возврат ВыполнитьПроверкуIP(Прокси);

КонецФункции


&НаКлиенте
Процедура ПроверкаСистемногоПрокси(Команда)

	Сообщить(ПроверитьСистемныйПроксиНаСервере());

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// БЕЗ ПРОКСИ
